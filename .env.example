# ============================================================================
# StrideSmart Environment Variables Template
# Copy this file to .env and fill in any optional keys.
# All services automatically fall back to free zero-key providers
# (Open-Meteo Weather & Air Quality, OSRM Routing, Carto Dark Vector Tiles,
# and Local Sandbox Mode) when keys are left blank.
# ============================================================================

# --- Backend: Supabase (Auth, Saved Routes, Run History) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Maps & Routing ---
# Optional: Mapbox or Google Maps API Key (falls back to Carto Dark + OSRM Foot Routing)
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Weather Integration ---
# Primary: Google Maps Platform Weather API key
# Fallback 1: Open-Meteo Forecast & Air Quality API (no key required, enabled automatically)
# Fallback 2: OpenWeatherMap API key
EXPO_PUBLIC_GOOGLE_WEATHER_API_KEY=
EXPO_PUBLIC_OPENWEATHER_API_KEY=

# --- Google Calendar OAuth 2.0 (Read-Only Scope: calendar.readonly) ---
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID_ANDROID=
